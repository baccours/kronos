<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12+. Only the saved workout setup (the DataStore in files/datastore)
    is backed up and moved to a new device; nothing else needs to be.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
